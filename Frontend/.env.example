# Local Vite dev proxy target.
VITE_BASE_API=http://localhost:6000

# Production backend origin used in the built app.
# Do not include /api or /api/v1.
VITE_API_BASE_URL=https://your-backend.onrender.com

# Public key used by the Stripe payment form in the frontend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
