PORT=6000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/market-place

JWT_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_EXPIRE=7d
JWT_ACCESS_MS=1800000
JWT_REFRESH_MS=604800000

CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API=your-cloudinary-api-key
CLOUDINARY_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_TIMEOUT_MS=120000

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mail-user
MAILTRAP_PASS=your-mail-password
MAIL_FROM=Marketplace <no-reply@example.com>

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx
FLUTTERWAVE_SECRET_HASH=replace-with-your-webhook-hash
FLUTTERWAVE_REDIRECT_URL=http://localhost:5173/payment-success

PROMO_CODES=WELCOME10:percentage:10:50:10_percent_off_orders_from_$50,SAVE20:fixed:20:150:$20_off_orders_from_$150,SHIPFREE:shipping:100:80:free_shipping_on_orders_from_$80
