MONGO_URI=mongodb://localhost:27017/marketplace
MONGO_INITDB_ROOT_USERNAME=marketplace_admin
MONGO_INITDB_ROOT_PASSWORD=marketplace_admin_password
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

JWT_SECRET=replace-me
JWT_ACCESS_EXPIRE=50m
JWT_ACCESS_MS=900000
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_MS=604800000
EXPIRE_COOKIE=3d
NODE_ENV=development

PORT=6000

# Comma-separated allowed frontend origins. The first entry is also used
# as the default payment return origin when an explicit target is not supplied.
FRONTEND_URL=http://localhost:5173

TRUST_PROXY_HOPS=1
# For separate production deployments on different domains, use
# COOKIE_SECURE=true and COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=replace-me@example.com
EMAIL_PASS=replace-me

CLOUDINARY_NAME=replace-me
CLOUDINARY_API=replace-me
CLOUDINARY_SECRET=replace-me

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_API_VERSION=2026-02-25.clover

PAYSTACK_SECRET_KEY=replace-me
PAYSTACK_PUBLIC_KEY=replace-me

FLUTTERWAVE_SECRET_KEY=replace-me
FLUTTERWAVE_ENCRYPTION_KEY=replace-me
FLUTTERWAVE_REDIRECT_URL=http://localhost:5173/payment-success

# Payment verification now relies on direct provider lookups after checkout returns.
PAYMENT_POLL_INTERVAL_MS=3000
PAYMENT_VERIFY_MAX_ATTEMPTS=5
PAYMENT_REQUEST_TIMEOUT_MS=10000
PAYMENT_REQUEST_MAX_ATTEMPTS=3
PAYMENT_REQUEST_RETRY_DELAY_MS=350

# Redis is optional in production. Leave REDIS_ENABLED=false if you are not provisioning Redis.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
REDIS_REQUIRED=false
